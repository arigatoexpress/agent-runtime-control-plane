{
  "name": "agent-runtime-control-plane",
  "version": "0.1.0",
  "private": true,
  "description": "Dry-run migration control plane for local-machine, Telegram, and runtime agent surfaces.",
  "type": "module",
  "scripts": {
    "repo-map": "node scripts/git-roots.mjs",
    "repo-map:write": "node scripts/git-roots.mjs --write data/repo-map.json",
    "inventory": "node scripts/inventory.mjs",
    "inventory:write": "node scripts/inventory.mjs --write data/latest-inventory.json",
    "surfaces": "node scripts/runtime-surfaces.mjs",
    "surfaces:write": "node scripts/runtime-surfaces.mjs --write data/runtime-surfaces.json",
    "surfaces:summary": "node scripts/runtime-surfaces.mjs --write-summary data/runtime-surfaces-summary.json",
    "launchagents": "node scripts/launchagents.mjs",
    "launchagents:write": "node scripts/launchagents.mjs --write data/launchagents.json",
    "launchagents:summary": "node scripts/launchagents.mjs --write-summary data/launchagents-summary.json",
    "launchagents:readiness": "node scripts/launchagent-readiness.mjs --write data/launchagent-readiness.md",
    "telegram": "node scripts/telegram-surfaces.mjs",
    "telegram:write": "node scripts/telegram-surfaces.mjs --write data/telegram-surfaces.json",
    "telegram:summary": "node scripts/telegram-surfaces.mjs --write-summary data/telegram-surfaces-summary.json",
    "frontends": "node scripts/frontend-inventory.mjs",
    "frontends:write": "node scripts/frontend-inventory.mjs --write data/frontend-inventory.md --write-json data/frontend-inventory.json",
    "quarantine-plan": "node scripts/quarantine-plan.mjs --write data/quarantine-plan.md",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm test && node --check scripts/inventory.mjs && node --check scripts/git-roots.mjs && node --check scripts/runtime-surfaces.mjs && node --check scripts/launchagents.mjs && node --check scripts/launchagent-readiness.mjs && node --check scripts/telegram-surfaces.mjs && node --check scripts/frontend-inventory.mjs && node --check scripts/quarantine-plan.mjs && npm run inventory && npm run repo-map && npm run surfaces && npm run launchagents && npm run telegram && npm run frontends"
  },
  "engines": {
    "node": ">=22"
  }
}
